"""Isolated batched-matrix Secure BP prototype numerical audit."""
import math
from Compiler import ml
from Compiler.library import for_range_opt, print_float_precision
from Compiler.mpc_math import log_fx

program.unlimited_compilation()
sfix.set_precision(16, 31)
print_float_precision(8)

BATCH_SIZE = 3
INPUTS, HIDDEN_1, HIDDEN_2, OUTPUTS = 784, 128, 128, 10
LR = sfix(0.05)
LOOP_BUDGET = 100

W1 = sfix.Matrix(INPUTS, HIDDEN_1)
b1 = sfix.Array(HIDDEN_1)
W2 = sfix.Matrix(HIDDEN_1, HIDDEN_2)
b2 = sfix.Array(HIDDEN_2)
W3 = sfix.Matrix(HIDDEN_2, OUTPUTS)
b3 = sfix.Array(OUTPUTS)
for parameter in (W1, b1, W2, b2, W3, b3):
    parameter.input_from(0, binary=False)

X = sfix.Matrix(BATCH_SIZE, INPUTS)
Y = sfix.Matrix(BATCH_SIZE, OUTPUTS)
sample_x = sfix.Array(INPUTS)
sample_y = sfix.Array(OUTPUTS)


def load_batch(batch_start):
    @for_range_opt(BATCH_SIZE, budget=LOOP_BUDGET)
    def _(sample):
        owner = (batch_start + sample) % 3
        sample_x.input_from(owner, binary=False)
        sample_y.input_from(owner, binary=False)
        X.assign(sample_x, sample * INPUTS)
        Y.assign(sample_y, sample * OUTPUTS)


def add_bias(values, bias, rows, columns):
    @for_range_opt(rows, budget=LOOP_BUDGET)
    def _(row):
        values.assign_vector(
            values.get_vector(row * columns, columns) +
            bias.get_vector(), row * columns)


def cross_entropy(logits, target):
    shifted_exp, shift = ml.exp_for_softmax(logits)
    log_sum_exp = shift + log_fx(sum(shifted_exp), math.e)
    return -(sum(target[k] * logits[k] for k in range(OUTPUTS))
             - log_sum_exp)


load_batch(0)

Z1 = sfix.Matrix(BATCH_SIZE, HIDDEN_1)
H1 = sfix.Matrix(BATCH_SIZE, HIDDEN_1)
Z2 = sfix.Matrix(BATCH_SIZE, HIDDEN_2)
H2 = sfix.Matrix(BATCH_SIZE, HIDDEN_2)
Z3 = sfix.Matrix(BATCH_SIZE, OUTPUTS)
P = sfix.Matrix(BATCH_SIZE, OUTPUTS)

Z1.assign_vector(X.direct_mul(W1))
add_bias(Z1, b1, BATCH_SIZE, HIDDEN_1)
H1.assign_vector(ml.relu(Z1.get_vector()))
Z2.assign_vector(H1.direct_mul(W2))
add_bias(Z2, b2, BATCH_SIZE, HIDDEN_2)
H2.assign_vector(ml.relu(Z2.get_vector()))
Z3.assign_vector(H2.direct_mul(W3))
add_bias(Z3, b3, BATCH_SIZE, OUTPUTS)

@for_range_opt(BATCH_SIZE, budget=LOOP_BUDGET)
def _(sample):
    P.assign_vector(ml.softmax(Z3[sample].get_vector()),
                    sample * OUTPUTS)

D3 = sfix.Matrix(BATCH_SIZE, OUTPUTS)
D2 = sfix.Matrix(BATCH_SIZE, HIDDEN_2)
D1 = sfix.Matrix(BATCH_SIZE, HIDDEN_1)
D3.assign_vector(P.get_vector() - Y.get_vector())
D2.assign_vector(D3.direct_mul_trans(W3))
D2.assign_vector(D2.get_vector() * (Z2.get_vector() > 0))
D1.assign_vector(D2.direct_mul_trans(W2))
D1.assign_vector(D1.get_vector() * (Z1.get_vector() > 0))

dW3 = sfix.Matrix(HIDDEN_2, OUTPUTS)
db3 = sfix.Array(OUTPUTS)
dW2 = sfix.Matrix(HIDDEN_1, HIDDEN_2)
db2 = sfix.Array(HIDDEN_2)
dW1 = sfix.Matrix(INPUTS, HIDDEN_1)
db1 = sfix.Array(HIDDEN_1)
dW3.assign_vector(H2.direct_trans_mul(D3, reduce=False).reduce_after_mul())
dW2.assign_vector(H1.direct_trans_mul(D2, reduce=False).reduce_after_mul())
dW1.assign_vector(X.direct_trans_mul(D1, reduce=False).reduce_after_mul())
for column in range(OUTPUTS):
    db3[column] = sum(D3.get_column(column))
for column in range(HIDDEN_2):
    db2[column] = sum(D2.get_column(column))
for column in range(HIDDEN_1):
    db1[column] = sum(D1.get_column(column))

scale = LR / BATCH_SIZE
W3.assign_vector(W3.get_vector() - scale * dW3.get_vector())
b3.assign_vector(b3.get_vector() - scale * db3.get_vector())
W2.assign_vector(W2.get_vector() - scale * dW2.get_vector())
b2.assign_vector(b2.get_vector() - scale * db2.get_vector())
W1.assign_vector(W1.get_vector() - scale * dW1.get_vector())
b1.assign_vector(b1.get_vector() - scale * db1.get_vector())

loss = sfix(0)
correct = sint(0)
loss_each = sfix.Array(BATCH_SIZE)
preds = sint.Array(BATCH_SIZE)
@for_range_opt(BATCH_SIZE, budget=LOOP_BUDGET)
def _(sample):
    logits = Z3[sample].get_vector()
    target = Y[sample].get_vector()
    sample_l = cross_entropy(logits, target)
    loss_each[sample] = sample_l
    loss.update(loss + sample_l)
    sample_pred = ml.argmax(logits)
    preds[sample] = sample_pred
    correct.update(correct + (sample_pred == ml.argmax(target)))

mean_loss = loss / BATCH_SIZE

print_ln("train_loss=%s correct=%s total=%s",
         mean_loss.reveal(), correct.reveal(), BATCH_SIZE)

# Deterministic machine-parseable numerical audit output
print_ln("AUDIT_START")
print_ln("AUDIT_TENSOR name=Z1 shape=3,128 values=%s", Z1.get_vector().reveal())
print_ln("AUDIT_TENSOR name=H1 shape=3,128 values=%s", H1.get_vector().reveal())
print_ln("AUDIT_TENSOR name=Z2 shape=3,128 values=%s", Z2.get_vector().reveal())
print_ln("AUDIT_TENSOR name=H2 shape=3,128 values=%s", H2.get_vector().reveal())
print_ln("AUDIT_TENSOR name=Z3 shape=3,10 values=%s", Z3.get_vector().reveal())
print_ln("AUDIT_TENSOR name=P shape=3,10 values=%s", P.get_vector().reveal())
print_ln("AUDIT_TENSOR name=predictions shape=3 values=%s", preds.get_vector().reveal())
print_ln("AUDIT_TENSOR name=loss_each shape=3 values=%s", loss_each.get_vector().reveal())
print_ln("AUDIT_TENSOR name=mean_loss shape=1 values=[%s]", mean_loss.reveal())
print_ln("AUDIT_TENSOR name=D3 shape=3,10 values=%s", D3.get_vector().reveal())
print_ln("AUDIT_TENSOR name=D2 shape=3,128 values=%s", D2.get_vector().reveal())
print_ln("AUDIT_TENSOR name=D1 shape=3,128 values=%s", D1.get_vector().reveal())
print_ln("AUDIT_TENSOR name=dW3 shape=128,10 values=%s", dW3.get_vector().reveal())
print_ln("AUDIT_TENSOR name=db3 shape=10 values=%s", db3.get_vector().reveal())
print_ln("AUDIT_TENSOR name=dW2 shape=128,128 values=%s", dW2.get_vector().reveal())
print_ln("AUDIT_TENSOR name=db2 shape=128 values=%s", db2.get_vector().reveal())
print_ln("AUDIT_TENSOR name=dW1 shape=784,128 values=%s", dW1.get_vector().reveal())
print_ln("AUDIT_TENSOR name=db1 shape=128 values=%s", db1.get_vector().reveal())
print_ln("AUDIT_TENSOR name=W1_new shape=784,128 values=%s", W1.get_vector().reveal())
print_ln("AUDIT_TENSOR name=b1_new shape=128 values=%s", b1.get_vector().reveal())
print_ln("AUDIT_TENSOR name=W2_new shape=128,128 values=%s", W2.get_vector().reveal())
print_ln("AUDIT_TENSOR name=b2_new shape=128 values=%s", b2.get_vector().reveal())
print_ln("AUDIT_TENSOR name=W3_new shape=128,10 values=%s", W3.get_vector().reveal())
print_ln("AUDIT_TENSOR name=b3_new shape=10 values=%s", b3.get_vector().reveal())
print_ln("AUDIT_END")
